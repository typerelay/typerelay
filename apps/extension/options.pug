doctype html
html(lang="en")
	head
		meta(charset="utf-8")
		meta(name="viewport" content="width=device-width, initial-scale=1")
		title Typerelay options
		link(rel="stylesheet" href="options.css")
	body
		main
			header
				img(src="icon.png" alt="" width="48" height="48")
				div
					h1 Typerelay options
					p Connect your snippets and choose how typing expands them.
			section
				h2 Account
				div.status-row
					p#account-state(role="status") Checking connection…
					button#disconnect.button-sm(type="button" hidden) Sign out
				p#auth-error.error(role="alert" hidden)
				form#server-form(hidden)
					label(for="server") Server
					div.server-group
						span https://
						input#server(type="text" value="app.typerelay.com" required autocapitalize="none" spellcheck="false")
						button#connect(type="submit") Sign in
					button#reset-server(type="button") reset
				div.actions
					button#restart-connect(type="button" hidden) Start over
			section
				h2 Sync
				div.status-row
					p#sync-summary Sign in to sync your snippets.
					button#sync.button-sm(type="button" disabled) Sync now
				p#last-sync
				div.actions
					span#sync-status(role="status")
			section
				h2 Trigger prefix
				div.prefix-group
					select#prefix
						option(value=";") ;
						option(value=",") ,
						option(value=".") .
						option(value="/") /
						option(value="'") '
						option(value="[") [
						option(value="]") ]
						option(value="\\") \
						option(value="`") `
						option(value="=") =
					label(for="prefix") Character before a snippet abbreviation
				p#prefix-status(role="status")
			section
				h2 Snippets
				div.status-row
					p Create and edit snippets in the Typerelay app.
					a#edit.button.button-sm(target="_blank" rel="noopener noreferrer") Open Typerelay
			section
				h2 About
				p#version
				p
					a(href="https://feedback.typerelay.com" target="_blank" rel="noopener noreferrer") Feedback
				p
					a(href="https://docs.typerelay.com" target="_blank" rel="noopener noreferrer") Docs
		script(type="module" src="options.js")
