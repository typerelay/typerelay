form(role="dialog" aria-label="Fill Typerelay snippet")
	h2 Fill snippet
	div(data-fields)
	div.actions
		button(type="button" data-cancel) Cancel
		button(type="submit") Insert
	template(data-single)
		div.field
			label
			input(type="text" autocomplete="off")
	template(data-multiline)
		div.field
			label
			textarea(rows="3")
