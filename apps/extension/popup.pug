doctype html
html(lang="en")
	head
		meta(charset="utf-8")
		meta(name="viewport" content="width=device-width, initial-scale=1")
		title Type Relay
		link(rel="stylesheet" href="popup.css")
	body
		main
			header
				img(src="icon.png" alt="" width="32" height="32")
				h1 Type Relay
				button#settings(type="button") Settings
			p#status(role="status" hidden)
			section#signed-out(hidden)
				p Sign in from settings to search your snippets.
			section#signed-in(hidden)
				label(for="search") Search snippets
				input#search(type="search" autocomplete="off" role="combobox" aria-autocomplete="list" aria-controls="results" aria-expanded="false")
				p#search-message(role="status") Type to search snippets.
				ul#results(role="listbox" hidden)
				template#result-template
					li(role="option" tabindex="-1" aria-selected="false")
						strong
						small
		script(type="module" src="popup.js")
