extends ../auth-layout
block head
	title System Administrator Login — Type Relay
block content
	h1.h2.mb-2 System administrator sign in
	p.text-muted.mb-5 Sign in to administer Type Relay.
	form(data-admin-login)
		.mb-3
			label.form-label(for="email") Email
			input#email.form-control.form-control-sm(type="email" name="email" required autocomplete="username" autofocus)
		.mb-4
			label.form-label(for="password") Password
			input#password.form-control.form-control-sm(type="password" name="password" required autocomplete="current-password")
		button.btn.btn-primary.btn-sm.w-100(type="submit") Sign in

block scripts
	script(src='/assets/' + assetVersion + '/admin.js' type="module")
