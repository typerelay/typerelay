doctype html
html(lang="en")
	head
		meta(charset="utf-8")
		meta(name="viewport" content="width=device-width, initial-scale=1")
		meta(name="csrf-token" content=csrf)
		title TypeRelay
		link(rel="icon" href="/assets/favicon.ico")
		link(rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css")
		link(rel="stylesheet" href="/vendor/sweetalert2/sweetalert2.min.css")
		link(rel="stylesheet" href="/assets/app.css")
		script(src="/vendor/bootstrap/js/bootstrap.bundle.min.js" defer)
		script(src="/vendor/sweetalert2/sweetalert2.all.min.js" defer)
		script(src="/vendor/webauthn/index.umd.min.js" defer)
		script(src="/assets/auth.js" type="module")
		script(src="/assets/app.js" type="module")
	body
		header.app-navbar.container-fluid.py-3.mb-5
			a.brand-link(href="/")
				img.brand(src="/assets/typerelay-logo.svg" alt="TypeRelay")
			if profile
				button#search-trigger.btn.global-search(type="button" aria-haspopup="dialog" aria-controls="search-modal")
					svg.me-2(width="1.1rem" height="1.1rem" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true")
						circle(cx="10.5" cy="10.5" r="7.5")
						path(d="m16 16 5 5")
					span Type
					kbd.mx-2 /
					span to search
					kbd.ms-auto#search-shortcut Ctrl K
				.dropdown.ms-auto
					include ajax/avatar
					ul.dropdown-menu.dropdown-menu-end
						li
							button.dropdown-item(type="button" data-bs-toggle="modal" data-bs-target="#settings") Settings
						li
							button.dropdown-item(type="button" data-bs-toggle="modal" data-bs-target="#trash") Trash
						li
							button.dropdown-item(type="button" data-bs-toggle="modal" data-bs-target="#help") Help
						li
							hr.dropdown-divider
						li
							button#logout.dropdown-item(type="button") Sign out
		main.container
			block content
		if profile
			button#scroll-top.btn.btn-primary.btn-sm.scroll-top(type="button" aria-label="Scroll to top" aria-hidden="true" tabindex="-1")
				span(aria-hidden="true") ↑
				span.ms-2 Top
