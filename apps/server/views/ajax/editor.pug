div(data-editor=library._id)
	.d-flex.align-items-center.justify-content-between.gap-3.mb-3
		h2.h4.fw-bold(data-library-title)= library.name
		.editor-actions.d-flex.align-items-center.gap-3.ms-auto
			a.btn.btn-outline-secondary.btn-sm(href='/api/v2/libraries/' + library._id + '/export-bundle' download) Export bundle
			button.btn.btn-outline-secondary.btn-sm(data-library-settings hidden=!library.permissions.manage) Sharing and settings
			button.btn.btn-primary.btn-sm(data-add-snippet hidden=!library.permissions.edit) Add snippet
	.snippet-controls.d-flex.align-items-center.justify-content-between.gap-3.pb-4.mb-3
		label.d-flex.align-items-center.gap-2.mb-0
			input.form-check-input.m-0(type="checkbox" data-select-all disabled=!library.permissions.edit aria-label="Select all snippets")
			span(data-select-all-label) Select all
	.bulk-actions.d-flex.align-items-center(hidden role="group" aria-label="Selected snippet actions")
		span.fw-semibold(data-selection-count role="status" aria-live="polite" aria-atomic="true")
		button.btn.btn-sm(type="button" data-bulk-move)
			svg(viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
				path(d="M3 7V5a2 2 0 0 1 2-2h4l3 3h7a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-2M3 12h12m-4-4 4 4-4 4")
			span Move to
		button.btn.btn-sm(type="button" data-bulk-trash)
			svg(viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
				path(d="M4 7h16M10 11v6m4-6v6M5 7l1 13h12l1-13M9 7V4h6v3")
			span Move to Trash
		button.btn.btn-sm(type="button" data-clear-selection aria-label="Clear selection" title="Clear selection")
			svg(viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true")
				path(d="m6 6 12 12M6 18 18 6")
	#snippets
		each snippet in library.snippets
			include snippet
