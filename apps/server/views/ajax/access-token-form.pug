form#access-token-form.card.mb-4
	.card-body
		h2.h5.card-title Create New Token
		label.form-label(for="token-name") Token name
		.input-group.input-group-sm
			input#token-name.form-control.form-control-sm(name="name" required maxlength="100" autocomplete="off")
			button.btn.btn-outline-secondary.btn-sm(type="submit") Create
