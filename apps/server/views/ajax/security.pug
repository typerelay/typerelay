h3.h6.fw-bold Security
.card.p-4.mb-4
	h6.fw-bold Password
	p.text-muted Generate a new random password, then copy it before closing.
	.d-flex.justify-content-end
		button#reset-password.btn.btn-outline-secondary.btn-sm(type="button") Reset password
	#password-result.d-none.mt-3
		label.form-label(for="new-password") Your new password
		.input-group.input-group-sm.mb-3
			input#new-password.form-control.form-control-sm(type="text" readonly autocomplete="off")
			button#copy-password.btn.btn-outline-secondary.btn-sm(type="button") Copy
		.d-flex.justify-content-end
			button#password-copied.btn.btn-primary.btn-sm(type="button") I copied the password
.card.p-4.mb-4
	h6.fw-bold Two-factor authentication
	p#totp-status.text-muted= profile.totp_enabled ? '2FA is enabled' : '2FA is not enabled'
	.d-flex.justify-content-end
		button#setup-totp.btn.btn-outline-secondary.btn-sm(type="button" hidden=profile.totp_enabled) Enable 2FA
		button#disable-totp.btn.btn-outline-danger.btn-sm(type="button" hidden=!profile.totp_enabled) Disable 2FA
	#totp-setup.d-none.mt-3
		p Scan this QR code with your authenticator app:
		img#totp-qr.mb-3(alt="Authenticator setup QR code")
		p
			span Or enter this secret manually:
			code#totp-secret.ms-3
	#totp-verify.d-none.mt-3
		form#totp-form
			label.form-label(for="totp-code") Authentication code
			input#totp-code.form-control.form-control-sm.mb-3(name="code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" required)
			.d-flex.justify-content-between
				button#cancel-totp.btn.btn-outline-secondary.btn-sm(type="button") Cancel
				button.btn.btn-primary.btn-sm Verify
if passkeysAvailable
	.card.p-4.mb-5
		h6.fw-bold Passkeys
		ul#passkeys.list-group.mb-3
		form#passkey-add-form
			label.form-label(for="passkey-name") Passkey name
			input#passkey-name.form-control.form-control-sm.mb-3(name="name" value="My passkey" required maxlength="100")
			.d-flex.justify-content-end
				button.btn.btn-outline-secondary.btn-sm(type="submit") Add passkey
else
	.alert.alert-secondary Passkeys are managed at app.typerelay.com because they are bound to that domain.
