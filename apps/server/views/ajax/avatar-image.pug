mixin avatarImage(person, style, key)
	.avatar-picture.rounded-circle(data-viewer-avatar=key title=person.name)
		span.avatar-initials(aria-hidden="true")= person.name.trim().split(/\s+/).map(word => word[0]).slice(0, 2).join('').toUpperCase()
		img.avatar-image.rounded-circle(src='https://ava.helpmonks.com/9.x/' + (style || 'initials') + '/svg?seed=' + encodeURIComponent(person.email) alt="" referrerpolicy="no-referrer")

if typeof person !== 'undefined'
	+avatarImage(person, avatarStyle, avatarKey)
