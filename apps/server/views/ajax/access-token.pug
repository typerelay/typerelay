li.list-group-item(data-access-token=String(grant._id))
	.d-flex.align-items-center.justify-content-between
		div
			strong= grant.name
			small.text-muted.ms-2
				span Created
				time.ms-1(datetime=new Date(grant.createdAt).toISOString() data-local-date)= new Date(grant.createdAt).toISOString()
		button.btn.btn-outline-danger.btn-sm.ms-3(type="button" data-delete-token=String(grant._id) aria-label="Delete token" title="Delete token")
			svg(width="0.875rem" height="0.875rem" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
				path(d="M3 6h18")
				path(d="M8 6V4h8v2")
				path(d="M19 6l-1 14H6L5 6")
				path(d="M10 11v5")
				path(d="M14 11v5")
