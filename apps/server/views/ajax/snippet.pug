article.snippet(tabindex="0" role="group" aria-label="Snippet " + (snippet.title || snippet.trigger || 'Untitled snippet') + " — Enter to edit" data-snippet=snippet.id data-revision=snippet.revision)
	.d-flex.align-items-center.justify-content-between.mb-3
		.snippet-selection.d-flex.align-items-center.gap-3
			label.d-flex.align-items-center.mb-0
				input.form-check-input.m-0(type="checkbox" data-select-snippet=snippet.id disabled=!library.permissions.edit aria-label="Select " + (snippet.title || snippet.trigger || 'Untitled snippet'))
			h3.h6.mb-0.fw-bold= (snippet.title || snippet.trigger || 'Untitled snippet')
			if snippet.title && snippet.trigger
				span.small.text-muted= snippet.trigger
		.d-flex.align-items-center
			button.btn.btn-outline-secondary.btn-sm.ms-3(type="button" data-copy-snippet=snippet.id) Copy
			if library.permissions.edit
				button.btn.btn-outline-secondary.btn-sm.ms-3(data-edit-snippet=snippet.id) Edit
				button.btn.btn-outline-danger.btn-sm.ms-3(data-delete-snippet=snippet.id) Trash
	pre.mb-0.snippet-expansion= snippet.replace
