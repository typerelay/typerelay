- const compactAuthor = typeof aiAuthorCompact !== 'undefined' && aiAuthorCompact
section.ai-author.mb-5(class=compactAuthor ? 'ai-author-compact card card-body' : '' data-ai-author)
	if !compactAuthor
		h3.h6 Write with AI
		p.text-muted.small(data-ai-effective="authoring")
	.row.align-items-center
		if !compactAuthor
			.col-md-4.mb-3
				label.form-label
					span Action
					select.form-select.form-select-sm(data-ai-action)
						option(value="generate") Generate
						option(value="improve") Improve
						option(value="translate") Translate
						option(value="template") Make a template
		.mb-3(class=compactAuthor ? 'col-12' : 'col-md-8')
			label.form-label
				span= compactAuthor ? 'What would you like to do?' : 'What would you like to write or change?'
				textarea.form-control.form-control-sm(data-ai-prompt rows="2" maxlength="4000")
	.d-flex.justify-content-end.mb-3
		button.btn.btn-outline-primary.btn-sm(type="button" data-ai-generate)
			if compactAuthor
				span.spinner-border.spinner-border-sm.me-2(data-ai-spinner hidden aria-hidden="true")
			span= compactAuthor ? 'Submit' : 'Generate proposal'
	p.text-muted.small(data-ai-author-status role="status")
	div(data-ai-proposal hidden)
		label.form-label
			span Proposed snippet
			textarea.form-control.form-control-sm(data-ai-draft rows="8")
		.d-flex.justify-content-between.mt-3
			button.btn.btn-outline-secondary.btn-sm(type="button" data-ai-discard) Discard
			button.btn.btn-primary.btn-sm.ms-3(type="button" data-ai-apply) Use draft
