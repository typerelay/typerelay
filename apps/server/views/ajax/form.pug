if kind === 'library'
	label.form-label.fw-bold(for="name") Library name
	input#name.form-control.form-control-sm.mb-4(name="name" value=library ? library.name : '' required maxlength="100")
	if library
		.form-check.d-flex.align-items-center.ps-0.mb-4
			input#shared.form-check-input.m-0(type="checkbox" name="shared" checked=library.shared)
			label.form-check-label.ms-3(for="shared") Shared with team
		label.form-label.fw-bold(for="editable") Editing
		select#editable.form-select.form-select-sm.mb-4(name="editable")
			option(value="false" selected=!library.editable) Creator and account admins only
			option(value="true" selected=library.editable) Assigned members may edit
		label.form-label.fw-bold(for="members-select") Members
		select#members-select.form-select.form-select-sm.mb-4(name="members" multiple disabled=!library.shared)
			each member in team.members
				option(value=member.user selected=library.members.map(String).includes(String(member.user)))= member.profile.email
		label.form-label.fw-bold(for="groups-select") Groups
		select#groups-select.form-select.form-select-sm.mb-4(name="groups" multiple disabled=!library.shared)
			each group in team.groups
				option(value=group._id selected=library.groups.map(String).includes(String(group._id)))= group.name
		button.btn.btn-outline-danger.btn-sm(type="button" data-delete-library=library._id) Move library to Trash
	else
		label.form-label.fw-bold(for="yaml-file") Import YAML (optional)
		input#yaml-file.form-control.form-control-sm.mb-4(type="file" accept=".yml,.yaml")
		label.form-label.fw-bold(for="yaml") YAML
		textarea#yaml.form-control.form-control-sm.mb-4(name="yaml") matches: []
		button#preview.btn.btn-outline-secondary.btn-sm(type="button") Validate import
		p#preview-result.mt-3
if kind === 'move'
	label.form-label.fw-bold(for="destination-library") Destination library
	select#destination-library.form-select.form-select-sm.mb-4(name="destination_library" required disabled=!destinations.length)
		each destination in destinations
			option(value=destination._id)= destination.name + (destination.shared ? ' · Shared' : ' · Personal')
	if !destinations.length
		p.text-muted No other editable libraries are available.
	p.text-muted Moved snippets inherit the destination library’s sharing and editing permissions.
if kind === 'snippet' || kind === 'conflict'
	.row.align-items-center
		.col-md-9
			label.form-label.fw-bold(for="snippet-title") Title (optional)
			input#snippet-title.form-control.form-control-sm.mb-3(name="title" value=snippet ? snippet.title : '' maxlength="500")
		.col-md-3
			label.form-label.fw-bold(for="snippet-type") Type
			select#snippet-type.form-select.form-select-sm.mb-3(name="type")
				option(value="plain_text" selected=!snippet || (snippet.content && snippet.content.type) === 'plain_text') Text
				option(value="code" selected=snippet && (snippet.content && snippet.content.type) === 'code') Code
				option(value="template" selected=snippet && (snippet.content && snippet.content.type) === 'template') Template
	label.form-label.fw-bold(for="trigger") Abbreviation (optional)
	.input-group.input-group-sm.mb-4
		span.input-group-text(aria-hidden="true") ,
		input#trigger.form-control.form-control-sm(name="trigger" value=snippet ? snippet.trigger : '' pattern="[a-z0-9\\-]{1,63}" autocapitalize="off" spellcheck="false")
	label.form-label.fw-bold(for="replace") Expansion
	textarea#replace.form-control.form-control-sm.mb-4(name="replace")= '\n' + (snippet ? snippet.replace : '')
	include template-editor
	#code-editor.mb-3
	#code-options.mb-3(hidden=!snippet || (snippet.content && snippet.content.type) !== 'code')
		.row.align-items-center
			.col-md-6
				label.form-label(for="code-language") Language
				select#code-language.form-select.form-select-sm.mb-2(name="language" data-language=(snippet && snippet.content && snippet.content.language) || 'plain_text')
					option(value="plain_text") Plain text
			.col-md-3
				label.form-label(for="code-indent") Tab inserts
				select#code-indent.form-select.form-select-sm.mb-2
					option(value="tabs") Literal tab
					option(value="spaces") Spaces
			.col-md-3
				label.form-label(for="code-width") Width
				select#code-width.form-select.form-select-sm.mb-2
					each width in [2, 4, 8]
						option(value=width selected=width === 4)= width
		p.small.text-muted Tab indents; Shift+Tab outdents. Press Escape then Tab to leave the editor. Existing whitespace stays unchanged.
	button#copy-code.btn.btn-outline-secondary.btn-sm.mb-3(type="button") Copy
	if kind === 'snippet' && snippet
		label.form-label.fw-bold(for="destination-library") Library
		select#destination-library.form-select.form-select-sm.mb-4(name="destination_library" disabled=!library.permissions.edit)
			option(value=library._id selected)= library.name + (library.shared ? ' · Shared' : ' · Personal')
			each destination in destinations
				option(value=destination._id)= destination.name + (destination.shared ? ' · Shared' : ' · Personal')
		p.text-muted Changing the library moves this snippet when you save. Destination sharing permissions apply.
	if kind === 'conflict'
		label.form-label.fw-bold(for="choice") Resolution
		select#choice.form-select.form-select-sm(name="choice")
			option(value="merged") Use fields above
			option(value="local") Use local version (including deletion)
			option(value="server") Keep current server version
		h3.h6.mt-3.fw-bold Local version
		pre= JSON.stringify(conflict.local, null, 2)
		h3.h6.fw-bold Current server version
		pre= JSON.stringify(current, null, 2)
if kind === 'group'
	label.form-label.fw-bold(for="name") Group name
	input#name.form-control.form-control-sm.mb-4(name="name" value=group ? group.name : '' required)
	label.form-label.fw-bold(for="users") Members
	select#users.form-select.form-select-sm.mb-4(name="users" multiple)
		each member in team.members
			option(value=member.user selected=group && group.users.map(String).includes(String(member.user)))= member.profile.email
	if group
		button.btn.btn-outline-danger.btn-sm(type="button" data-delete-group=group._id) Delete group

if kind === 'snippetslab' || kind === 'import'
	label.form-label.fw-bold(for="import-file")= importFormat.name + ' export'
	input#import-file.form-control.form-control-sm.mb-3(type="file" accept=importFormat.accept)
	p.small.text-muted= importFormat.instructions
	if importFormat.beta
		p.small.text-muted Beta: export layouts may vary between app versions. Review the preview before importing.
	p.small.text-muted Imported libraries are private. Existing libraries are never replaced.
	button#preview-import.btn.btn-outline-secondary.btn-sm.mb-3(type="button") Preview import
	#import-preview
