#billing-nav-action
	if canManageBilling && billingEnabled
		if isTrialing
			button.btn.btn-warning.btn-sm(type="button" data-settings-open="subscription")= trialText
		else if plan === 'free' && trialAvailable
			button.btn.btn-warning.btn-sm(type="button" data-start-trial) Try PRO for 7 days for free
		else if plan === 'free'
			button.btn.btn-outline-primary.btn-sm(type="button" data-settings-open="subscription") Upgrade to Pro
