.alert.alert-success.alert-dismissible.fade.show(data-token-secret=id role="status")
	strong Token created!
	.input-group.input-group-sm.mt-2
		input.form-control.form-control-sm(type="text" readonly value=token data-secret-value autocomplete="off")
		button.btn.btn-outline-secondary.btn-sm(type="button" data-copy-secret)
			svg(width="0.875rem" height="0.875rem" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
				rect(x="9" y="9" width="13" height="13" rx="2")
				path(d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1")
			span.ms-1 Copy
	span.small.text-muted.d-block.mt-2 Copy it now — it will not be shown again.
	button.btn-close(type="button" data-dismiss-secret aria-label="Close")
