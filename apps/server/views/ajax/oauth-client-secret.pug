.alert.alert-success.alert-dismissible.fade.show(data-oauth-client-secret role="status")
	strong Client secret created!
	.input-group.input-group-sm.mt-2
		input.form-control.form-control-sm(type="text" readonly value=secret data-secret-value autocomplete="off")
		button.btn.btn-outline-secondary.btn-sm(type="button" data-copy-secret) Copy
	span.small.text-muted.d-block.mt-2 Copy it now — it will not be shown again.
	button.btn-close(type="button" data-dismiss-secret aria-label="Close")
