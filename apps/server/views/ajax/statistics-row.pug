tr(data-statistics-id=row.id)
	td
		span= row.name
		if kind === 'snippets'
			div.small.text-muted= row.library
	td
		span= row.uses.toLocaleString()
		if kind === 'snippets' || kind === 'libraries'
			.statistics-usage-track(aria-hidden="true")
				span.statistics-usage-bar(data-statistics-uses=row.uses)
	td= row.characters.toLocaleString()
	td= row.minutes.toFixed(1)
	td= new Intl.NumberFormat('en', { style: 'currency', currency: settings.currency }).format(row.money)
