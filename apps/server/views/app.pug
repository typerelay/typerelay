extends layout
block content
	#workspace(data-account=account._id)
		.row#workspace-content(hidden=typeof news !== 'undefined' && news)
			aside.col-md-4
				.library-controls.d-flex.align-items-center.gap-3.mb-3
					select#account-switch.form-select.form-select-sm(aria-label="Account")
						each item in accounts
							option(value=item._id selected=String(item._id) === String(account._id))= item.name
					button#new-library.btn.btn-primary.btn-sm New library
				- var selectedLibrary = libraries.length ? String(libraries[0]._id) : null
				#libraries
					each library in libraries
						include ajax/library
				.dropdown.mt-3
					button#import-menu.btn.btn-outline-secondary.btn-sm.dropdown-toggle(type="button" data-bs-toggle="dropdown" aria-expanded="false") Import
					ul.dropdown-menu
						each format, id in importFormats
							li
								button.dropdown-item(type="button" data-import-format=id)= format.name + (format.beta ? ' · Beta' : '')

			section.col-md-8
				#editor.card.p-4
					if libraries.length
						- var library = libraries[0]
						include ajax/editor
					else
						h2.fw-bold Select a library
						p.text-muted Import YAML or create your first library.
		#conflicts.mt-3(hidden=typeof news !== 'undefined' && news)
		if typeof productUpdatesEnabled !== 'undefined' && productUpdatesEnabled
			#news-view(hidden=!news)
				if news
					include ajax/section/news
		#rich-image-modal.modal.fade(tabindex="-1" aria-label="Add rich-text image" data-bs-backdrop="static" data-bs-keyboard="false")
			.modal-dialog.modal-lg.modal-dialog-scrollable
				.modal-content
					.modal-header
						h2.modal-title.h5.fw-bold Add image
						button.btn-close(type="button" data-bs-dismiss="modal" aria-label="Close")
					form#rich-image-form
						.modal-body
							label.form-label(for="rich-image-file") Upload image
							input#rich-image-file.form-control.form-control-sm.mb-3(type="file" accept="image/png,image/jpeg,image/webp,image/gif")
							label.form-label(for="rich-image-url") Or remote image URL
							input#rich-image-url.form-control.form-control-sm.mb-3(type="url")
							.row.align-items-center
								.col-md-6
									label.form-label(for="rich-image-alt") Alt text
									input#rich-image-alt.form-control.form-control-sm.mb-3(maxlength="500")
								.col-md-6
									label.form-label(for="rich-image-title") Title
									input#rich-image-title.form-control.form-control-sm.mb-3(maxlength="500")
							.row.align-items-center
								.col-md-6
									label.form-label(for="rich-image-placement") Placement
									select#rich-image-placement.form-select.form-select-sm.mb-3
										option(value="inline") Inline
										option(value="block") Block
								.col-md-6
									label.form-label(for="rich-image-width") Display width
									input#rich-image-width.form-control.form-control-sm.mb-3(type="number" min="32" max="2048" value="640")
							p.small.text-muted.mb-0 Remote images are cached privately for reliable offline insertion.
						.modal-footer.justify-content-between
							button.btn.btn-outline-secondary.btn-sm(type="button" data-bs-dismiss="modal") Cancel
							button.btn.btn-primary.btn-sm(type="submit") Add image
		#settings.modal.fade(tabindex="-1" aria-label="Settings" data-bs-backdrop="static" data-bs-keyboard="false")
			.modal-dialog.modal-xl.modal-dialog-scrollable.settings-dialog
				.modal-content
					.modal-header
						h2.modal-title.h5.fw-bold Settings
						button.btn-close(data-bs-dismiss="modal" aria-label="Close")
					.modal-body.settings-body.p-0
						nav.settings-nav.list-group.list-group-flush(role="tablist" aria-label="Settings sections" aria-orientation="vertical")
							- var settingsSections = {profile: 'Profile', security: 'Security', team: 'My team', devices: 'Connected devices', tokens: 'Apps Access'}
							if billingEnabled
								- settingsSections.subscription = 'Subscription'
								if ['owner', 'admin'].includes(ctx.role)
									- settingsSections.whiteLabel = 'White-label'
							each label, key in settingsSections
								button.list-group-item.list-group-item-action(type="button" role="tab" id='settings-tab-' + key data-settings-tab=key aria-controls='settings-pane-' + key aria-selected=(key === 'profile').toString() tabindex=key === 'profile' ? '0' : '-1' class=key === 'profile' ? 'active' : '')= label
						.settings-content
							section.settings-pane(id="settings-pane-profile" role="tabpanel" aria-labelledby="settings-tab-profile" hidden=false)
								h3.h6.fw-bold Profile
								form#profile-form.mb-5
									label.form-label(for="profile-name") Name
									input#profile-name.form-control.form-control-sm.mb-3(name="name" value=profile.name required)
									label.form-label(for="profile-email") Email address
									input#profile-email.form-control.form-control-sm.mb-3(name="email" type="email" value=profile.email required)
									p#profile-status.text-muted New email addresses must be verified before they replace your current address.
									.d-flex.justify-content-end
										button.btn.btn-primary.btn-sm Save
							section.settings-pane(id="settings-pane-security" role="tabpanel" aria-labelledby="settings-tab-security" hidden=true)
								include ajax/security
							section.settings-pane(id="settings-pane-team" role="tabpanel" aria-labelledby="settings-tab-team" hidden=true)
								h3.h6.fw-bold.mb-4 My Team
								if !ctx.entitlements.capabilities.team
									.alert.alert-warning Team management and sharing require Team. Existing extra members can be removed after a downgrade.
								.row.g-4.mb-5
									if ['owner', 'admin'].includes(ctx.role) && ctx.entitlements.capabilities.team
										.col-lg-5
											.card.team-settings-card.h-100
												.card-body
													h6.card-title.d-flex.align-items-center.gap-2.mb-3
														svg(width="1.25rem" height="1.25rem" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
															circle(cx="9" cy="7" r="4")
															path(d="M3 21v-2a6 6 0 0 1 6-6h2")
															path(d="M19 8v6")
															path(d="M16 11h6")
														span Add teammate
													form#team-member-form
														label.form-label(for="team-member-name") Name
														input#team-member-name.form-control.form-control-sm.mb-3(name="name" required autocomplete="name")
														label.form-label(for="team-member-email") Email
														input#team-member-email.form-control.form-control-sm.mb-3(name="email" type="email" required autocomplete="email")
														label.form-label(for="team-member-password") Password
														.input-group.input-group-sm
															input#team-member-password.form-control.form-control-sm(name="password" type="text" readonly autocomplete="off" spellcheck="false" aria-describedby="team-member-password-help team-member-password-status")
															button#team-member-copy-password.btn.btn-outline-secondary.btn-sm.d-inline-flex.align-items-center(type="button" aria-label="Copy password" title="Copy password")
																svg(width="0.875rem" height="0.875rem" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
																	rect(x="9" y="9" width="13" height="13" rx="2")
																	path(d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1")
																span.ms-1 Copy
															button#team-member-rotate-password.btn.btn-outline-secondary.btn-sm.d-inline-flex.align-items-center(type="button" aria-label="Rotate password" title="Rotate password")
																svg(width="0.875rem" height="0.875rem" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
																	path(d="M20 7h-5V2")
																	path(d="M20 7a9 9 0 1 0 2 9")
																span.ms-1 Rotate
														p#team-member-password-help.small.text-muted.mt-2.mb-1 Generated for new Type Relay users. Existing users keep their password.
														p#team-member-password-status.small.text-muted.mb-3(aria-live="polite")
														.form-check.mb-3
															input#team-member-send-welcome.form-check-input.h-20px.w-30px(type="checkbox" name="send_welcome_email" checked)
															label.form-check-label(for="team-member-send-welcome") Send email notification
														.text-end
															button.btn.btn-primary.btn-sm(type="submit") Add user
									.col-12(class=['owner', 'admin'].includes(ctx.role) && ctx.entitlements.capabilities.team ? 'col-lg-7' : '')
										.card.team-settings-card.h-100
											.card-body
												h6.card-title.d-flex.align-items-center.gap-2.mb-3
													svg(width="1.25rem" height="1.25rem" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
														path(d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2")
														circle(cx="9" cy="7" r="4")
														path(d="M22 21v-2a4 4 0 0 0-3-3.87")
														path(d="M16 3.13a4 4 0 0 1 0 7.75")
													span Members
												#members.team-member-list
													each member in team.members
														include ajax/member
												if team.invitations.length
													h6.mt-4.mb-3 Pending invitations
													#invitations.list-group.list-group-flush
														each invitation in team.invitations
															include ajax/invitation
												else
													#invitations
								.row.g-4
									if ctx.entitlements.capabilities.team
										.col-lg-7
											.card.team-settings-card
												.card-body
													h6.card-title.mb-3 Groups
													ul#groups.list-group.list-group-flush.mb-3
														each group in team.groups
															include ajax/group
													if ['owner', 'admin'].includes(ctx.role)
														button#new-group.btn.btn-outline-secondary.btn-sm.mb-3(type="button") New group
														- var groupForm = null
														include ajax/group-form
									if ['owner', 'admin'].includes(ctx.role)
										.col-lg-5
											.card.team-settings-card
												.card-body
													h6.card-title.mb-3 Account
													form#account-form
														label.form-label(for="account-name") Account name
														input#account-name.form-control.form-control-sm.mb-3(name="name" value=account.name required)
														.text-end
															button.btn.btn-primary.btn-sm Save
							section.settings-pane(id="settings-pane-devices" role="tabpanel" aria-labelledby="settings-tab-devices" hidden=true)
								h3.h6.fw-bold Connected devices
								ul#devices.list-group.mb-3
							section.settings-pane(id="settings-pane-tokens" role="tabpanel" aria-labelledby="settings-tab-tokens" hidden=true)
								h3.h6.fw-bold Access Tokens
								if !ctx.entitlements.capabilities.api
									.alert.alert-warning API and MCP access require Pro or Team. Existing tokens stay stored but cannot authenticate.
								ul.nav.nav-pills.settings-tabs.mb-4(role="tablist")
									li.nav-item(role="presentation")
										button.nav-link.active(type="button" data-bs-toggle="tab" data-bs-target="#access-tokens-pane" role="tab" aria-controls="access-tokens-pane" aria-selected="true") Access Tokens
									li.nav-item(role="presentation")
										button.nav-link(type="button" data-bs-toggle="tab" data-bs-target="#oauth-pane" role="tab" aria-controls="oauth-pane" aria-selected="false") OAuth
								.tab-content
									.tab-pane.fade.show.active#access-tokens-pane(role="tabpanel")
										#access-token-form-container
											if ctx.entitlements.capabilities.api
												include ajax/access-token-form
										#access-token-secret.mb-4
										ul#access-tokens.list-group.mb-5
									.tab-pane.fade#oauth-pane(role="tabpanel")
										.card.mb-4
											.card-body
												h2.h5.card-title OAuth & Connected Apps
												p.text-muted.mb-3 OAuth lets API and MCP clients connect to Type Relay with your approval.
												.small.text-muted.mb-1 MCP Endpoint
												code.small#oauth-mcp-endpoint Loading…
												.alert.alert-secondary.small.mt-3.mb-3
													span Use this endpoint in OAuth-capable clients. See the
													a.ms-1(href="/docs/mcp/setup" target="_blank" rel="noopener") setup guide
												h3.h6 Supported registration methods
												.d-flex.flex-wrap.gap-2
													span.badge.text-bg-secondary Dynamic registration
													span.badge.text-bg-secondary Pre-registration
												details.mt-3
													summary.fw-semibold Advanced OAuth metadata
													.pt-3
														.small.text-muted.mb-1 Issuer
														code.small#oauth-issuer Loading…
														.small.text-muted.mt-3.mb-1 Resource Metadata
														code.small#oauth-resource-metadata Loading…
														.small.text-muted.mt-3.mb-1 Authorization Server Metadata
														code.small#oauth-auth-metadata Loading…
										h2.h5 Authorized Apps
										#oauth-consents.list-group.mb-5
										if ['owner', 'admin'].includes(ctx.role)
											h2.h5 Pre-Registered OAuth Clients
											#oauth-client-form-container
												if ctx.entitlements.capabilities.api
													include ajax/oauth-client-form
											#oauth-client-secret.mb-4
											#oauth-clients.list-group.mb-5
							if billingEnabled
								section.settings-pane(id="settings-pane-subscription" role="tabpanel" aria-labelledby="settings-tab-subscription" hidden=true)
									include ajax/subscription
								if ['owner', 'admin'].includes(ctx.role)
									section.settings-pane(id="settings-pane-whiteLabel" role="tabpanel" aria-labelledby="settings-tab-whiteLabel" hidden=true)
										include ajax/white-label
		include ajax/template-fill
		#form-modal.modal.fade(tabindex="-1" aria-label="Edit" data-bs-backdrop="static" data-bs-keyboard="false")
			.modal-dialog.modal-xl.modal-dialog-scrollable
				.modal-content
					.modal-header
						h2#form-title.modal-title.h5.fw-bold
						button.btn-close(data-bs-dismiss="modal" aria-label="Close")
					.modal-body
						form#record-form
							#form-fields
							.d-flex.justify-content-between.mt-3
								button.btn.btn-outline-secondary.btn-sm(type="button" data-bs-dismiss="modal") Cancel
								button.btn.btn-primary.btn-sm(type="submit") Save

		#help.modal.fade(tabindex="-1" aria-label="Help" data-bs-backdrop="static" data-bs-keyboard="false")
			.modal-dialog
				.modal-content
					.modal-header
						h2.modal-title.h5.fw-bold TypeRelay help
						button.btn-close(data-bs-dismiss="modal" aria-label="Close")
					.modal-body
						h3.h6.fw-bold Libraries
						p Create a library or import a YAML file, then add abbreviations and expansions. The trigger prefix stays in your desktop settings.
						h3.h6.fw-bold Connect your desktop
						pre= 'typerelay connect --server ' + serverOrigin
						pre typerelay enroll "Library name"
						p Only local libraries you enroll are uploaded. Shared libraries available to you download automatically.
						h3.h6.fw-bold Sync and conflicts
						p Press F5 in the TUI to sync now. Conflicts appear here for review; local drafts are kept in your TypeRelay sync/recovery directory.
						a(href="https://github.com/typerelay/typerelay/tree/main/docs" target="_blank" rel="noopener") Documentation

		#search-modal.modal(tabindex="-1" aria-labelledby="search-title" data-bs-backdrop="static" data-bs-keyboard="false")
			.modal-dialog.modal-lg.modal-dialog-scrollable
				.modal-content
					h2#search-title.visually-hidden.fw-bold Search
					.modal-header.search-input-row
						svg.me-2(width="1.25rem" height="1.25rem" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true")
							circle(cx="10.5" cy="10.5" r="7.5")
							path(d="m16 16 5 5")
						label.visually-hidden(for="search") Search libraries and snippets
						input#search.form-control.form-control-sm.border-0(type="search" autocomplete="off" aria-describedby="search-help")
						button.btn.btn-sm.ms-3(type="button" data-bs-dismiss="modal" aria-label="Close search")
							span Close
					.modal-body
						p#search-help.text-muted.small Search library names, abbreviations and expansion text.
						#search-results(aria-live="polite")
					.modal-footer.justify-content-between
						span.small.text-muted ↑ ↓ Navigate · Enter Open
						span.small.text-muted Use Close to dismiss

		#trash.modal.fade(tabindex="-1" aria-label="Trash" data-bs-backdrop="static" data-bs-keyboard="false")
			.modal-dialog.modal-lg.modal-dialog-scrollable
				.modal-content
					.modal-header
						h2.modal-title.h5.fw-bold Trash
						button.btn-close(type="button" data-bs-dismiss="modal" aria-label="Close")
					.modal-body
						p.text-muted Trashed items can be restored for 30 days.
						#trash-items.list-group
						p#trash-empty.text-muted Trash is empty.
					.modal-footer
						button#empty-trash.btn.btn-outline-danger.btn-sm(type="button" disabled) Empty Trash

		button#beta-notice-trigger.beta-notice-trigger(type="button" data-bs-toggle="modal" data-bs-target="#beta-notice-modal" aria-label="About the TypeRelay beta" hidden) Beta
		#beta-notice-modal.modal.fade(tabindex="-1" aria-labelledby="beta-notice-title" data-bs-backdrop="static" data-bs-keyboard="false")
			.modal-dialog.modal-sm.modal-dialog-centered
				.modal-content
					.modal-header
						h2#beta-notice-title.modal-title.h5.fw-bold TypeRelay is in beta
						button.btn-close(type="button" data-bs-dismiss="modal" aria-label="Close")
					.modal-body
						p TypeRelay is still improving. You may encounter bugs or incomplete features during beta.
					.modal-footer
						button.btn.btn-primary.btn-sm(type="button" data-bs-dismiss="modal") Got it
