doctype html
html(lang="en")
	head
		meta(charset="utf-8")
		meta(name="viewport" content="width=device-width, initial-scale=1")
		title TypeRelay
		link(rel="stylesheet" href="panel.css")
		link(rel="stylesheet" href="sweetalert2.min.css")
		script(src="sweetalert2.all.min.js" defer)
		script(src="panel.js" defer)
	body
		main
			header.titlebar(data-tauri-drag-region)
				.brand
					img(src="icon.svg" alt="" width="24" height="24")
					h1#window-title TypeRelay
				button#open-settings.icon-button(type="button" aria-label="Open settings" title="Settings")
					span(aria-hidden="true") ⚙︎
				button#close.icon-button(type="button" aria-label="Close TypeRelay") ×
			section#search-view
				.search-field
					span.search-icon(aria-hidden="true")
					label.visually-hidden(for="query") Search snippets
					input#query(type="search" autocomplete="off" spellcheck="false" aria-controls="results")
				#empty-state(hidden)
					p Hey there, you have no snippets yet. Connect to your server to sync, create your first snippet in the TypeRelay web app, or use TypeRelay TUI.
					.empty-actions
						button#empty-sync.link-button(type="button") Sync snippets
						button#empty-web.link-button(type="button") TypeRelay web app
						button#empty-tui.link-button(type="button") TypeRelay TUI
				p#hint Type an abbreviation or part of a snippet.
				ul#results(role="listbox" aria-label="Snippets")
				footer
					span
						span.keycap ↑↓
						span Select
						span.keycap ↩
						span Insert
						span.keycap esc
						span Close
					button#copy.secondary(type="button" disabled) Copy
			section#fill-view(hidden)
				form#fill-form
					h2 Fill template
					#fill-fields
					label Preview
					pre#fill-preview
					p#fill-actions
					.row.form-actions
						button#fill-cancel(type="button") Cancel
						span.action-group
							button#fill-copy.secondary(type="button") Copy filled text
							button#fill-submit.primary(type="submit") Insert
			section#settings-view(hidden)
				.settings-heading
					button#settings-cancel.back-button(type="button") ‹ Search
					h2.visually-hidden Settings
				nav.settings-tabs(aria-label="Settings sections")
					button(type="button" data-settings-tab="general" aria-selected="true") General
					button(type="button" data-settings-tab="sync" aria-selected="false") Sync
				section#settings-general.settings-page
					form#settings-form.settings-list
						.setting-row
							.setting-copy
								h3 Search shortcut
								p Open TypeRelay from any app.
							.setting-control.shortcut-control
								label.visually-hidden(for="shortcut") Search shortcut
								input#shortcut(required)
								small Ctrl, Shift, Alt or Super + key
						.setting-row
							.setting-copy
								h3 Start at login
								p Keep TypeRelay ready in the menu bar.
							label.switch
								input#autostart(type="checkbox")
								span.switch-track(aria-hidden="true")
						.settings-actions
							button.primary(type="submit") Save changes
					.settings-list.mac-only
						.setting-row#input-monitoring-card
							.setting-copy
								h3 Input Monitoring
								p Open Settings. If TypeRelay is absent, click Add; then enable it.
							.setting-control
								span#input-monitoring-state.status-pill
								button#open-input-monitoring.secondary(type="button") Open Settings
						.setting-row#accessibility-card
							.setting-copy
								h3 Accessibility
								p Return focus and insert snippets into other apps.
							.setting-control
								span#accessibility-state.status-pill
								button#open-accessibility.secondary(type="button") Open Settings
						.setting-row#notifications-card
							.setting-copy
								h3 Notifications
								p Enable TypeRelay notifications. For banners during screen sharing, allow notifications when mirroring or sharing the display.
							.setting-control
								span#notifications-state.status-pill
								button#open-notifications.secondary(type="button") Open Settings
						.setting-row#tui-card
							.setting-copy
								h3 TypeRelay TUI
								p Edit local libraries and snippets in Terminal.
							button#open-tui.secondary(type="button") Open
				section#settings-sync.settings-page(hidden)
					.settings-list
						form#connect-form.setting-section
							label(for="server") Sync server URL
							input#server(type="url" value="https://app.typerelay.com" required)
							.form-actions
								button#sync.secondary(type="button") Sync now
								span.action-group
									button#disconnect.secondary(type="button") Disconnect
									button#authenticate.primary(type="submit") Authenticate
							p#connection-status.settings-description(role="status" aria-live="polite") Not connected
						section#enroll-form.setting-section
							h3 Libraries on this device
							p Synced libraries are available offline. Select local-only libraries to upload.
							div#local-libraries
							.form-actions
								span
								button#upload-selected.primary(type="button") Upload selected
						section#conflict-section.setting-section(hidden)
							h3 Needs review
							p#conflict-count.settings-description
							div#sync-conflicts
		template#result-template
			li(role="option" aria-selected="false")
				.row
					strong.result-title
					span.result-library
				code.result-abbreviation
				pre.result-preview
		template#library-template
			div.library-row
				label.check
					input(type="checkbox")
					span.library-name
					span.library-sync-state.status-pill
				button.library-merge.secondary(type="button") Merge…
				div.library-merge-form(hidden)
					label Destination
					select.library-merge-destination.form-select-sm
					.form-actions
						button.library-merge-cancel.secondary(type="button") Cancel
						button.library-merge-submit.primary(type="button") Merge library
		template#merge-option-template
			option
		template#conflict-template
			article.sync-conflict
				button.conflict-open.secondary(type="button")
				div.conflict-detail(hidden)
					h3 Base record
					pre.conflict-base
					h3 Local record
					pre.conflict-local
					h3 Server record
					pre.conflict-server
					form.conflict-form
						label Resolution
						select.conflict-choice.form-select-sm(name="choice")
							option(value="merged") Edit merge
							option(value="local") Keep local
							option(value="server") Keep server
						label Title
						input.conflict-title.form-control-sm(name="title" maxlength="500")
						label Abbreviation
						input.conflict-trigger.form-control-sm(name="trigger" pattern="[a-z0-9\\-]{1,63}")
						label Type
						select.conflict-type.form-select-sm(name="type")
							option(value="plain_text") Text
							option(value="template") Template
							option(value="code") Code
							option(value="rich_text") Rich text
						label Content
						textarea.conflict-body.form-control-sm(name="body" rows="8")
						label Language
						input.conflict-language.form-control-sm(name="language")
						.form-actions
							button.conflict-cancel.secondary(type="button") Cancel
							button.primary(type="submit") Resolve

		template#fill-field
			div
				label
				input(autocomplete="off")
				textarea(hidden)
