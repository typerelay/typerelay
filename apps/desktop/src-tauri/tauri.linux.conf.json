{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBundleCommand": "node scripts/stage-native-tools.mjs"
  },
  "bundle": {
    "externalBin": [
      "binaries/typerelay",
      "binaries/typerelay-tui",
      "binaries/typerelay-ai"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libatspi2.0-0",
          "acl",
          "udev",
          "kmod",
          "libnotify-bin",
          "pkexec",
          "foot",
          "systemd",
          "libxkbcommon0",
          "xkb-data"
        ],
        "files": {
          "/usr/lib/systemd/user/typerelay.service": "linux/typerelay.service",
          "/usr/lib/udev/rules.d/70-typerelay.rules": "linux/70-typerelay.rules",
          "/usr/lib/modules-load.d/typerelay.conf": "linux/typerelay.conf",
          "/usr/share/applications/typerelay-tui.desktop": "linux/typerelay-tui.desktop"
        },
        "postInstallScript": "linux/post-install.sh",
        "postRemoveScript": "linux/post-remove.sh"
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "at-spi2-core",
          "acl",
          "systemd-udev",
          "kmod",
          "libnotify",
          "polkit",
          "foot",
          "systemd",
          "libxkbcommon",
          "xkeyboard-config"
        ],
        "files": {
          "/usr/lib/systemd/user/typerelay.service": "linux/typerelay.service",
          "/usr/lib/udev/rules.d/70-typerelay.rules": "linux/70-typerelay.rules",
          "/usr/lib/modules-load.d/typerelay.conf": "linux/typerelay.conf",
          "/usr/share/applications/typerelay-tui.desktop": "linux/typerelay-tui.desktop"
        },
        "postInstallScript": "linux/post-install.sh",
        "postRemoveScript": "linux/post-remove.sh"
      }
    }
  }
}
