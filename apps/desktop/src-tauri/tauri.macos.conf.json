{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBundleCommand": "node scripts/stage-native-tools.mjs"
  },
  "app": {
    "windows": [
      {
        "label": "panel",
        "title": "TypeRelay",
        "width": 640,
        "height": 480,
        "visible": false,
        "decorations": true,
        "resizable": false,
        "minimizable": false,
        "maximizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "transparent": true,
        "shadow": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 14,
          "y": 18
        },
        "windowEffects": {
          "effects": ["popover"],
          "state": "active",
          "radius": 16
        }
      }
    ]
  },
  "bundle": {
    "externalBin": [
      "binaries/typerelay-tui"
    ]
  }
}
