form#editor-form.mobile-editor
	- var storedSnippetType = snippet && snippet.content.type || 'plain_text'
	- var snippetType = storedSnippetType === 'template' ? 'plain_text' : storedSnippetType
	- var snippetLanguage = snippet && snippet.content.language || 'plain_text'
	- var codeLanguages = [['plain_text', 'Plain text'], ['JavaScript', 'JavaScript'], ['TypeScript', 'TypeScript'], ['HTML', 'HTML'], ['CSS', 'CSS'], ['JSON', 'JSON'], ['Markdown', 'Markdown'], ['Python', 'Python'], ['Rust', 'Rust'], ['Shell', 'Shell'], ['SQL', 'SQL'], ['Java', 'Java'], ['Kotlin', 'Kotlin'], ['Swift', 'Swift'], ['Go', 'Go'], ['PHP', 'PHP'], ['Ruby', 'Ruby'], ['YAML', 'YAML'], ['XML', 'XML'], ['C', 'C'], ['C++', 'C++']]
	header.flow-header
		button.flow-back#cancel-edit(type="button" aria-label="Close editor")
			span.material-symbols-outlined arrow_back
		div
			span.eyebrow= snippet ? 'Edit snippet' : 'New snippet'
			h2= snippet && (snippet.title || snippet.trigger) || 'Untitled snippet'
		.flow-actions
			if draft || (snippet && library.permissions.edit)
				button.flow-trash#delete-editor-item(type="button" aria-label=snippet ? 'Move snippet to Trash' : 'Discard draft')
					span.material-symbols-outlined delete
			button.flow-save#save(type="submit") Save
	.flow-body
		label.mobile-field(for="edit-library")
			span Library
			select#edit-library(required disabled=!!snippet)
				each item in libraries
					if item.permissions.edit
						option(value=item._id selected=item._id===library._id)= item.name
		.mobile-field-grid
			label.mobile-field(for="title")
				span Title
				input#title(value=snippet && snippet.title || '')
			label.mobile-field(for="trigger")
				span Abbreviation
				input#trigger(value=snippet && snippet.trigger || '' autocapitalize="none" autocorrect="off")
		.mobile-field-grid
			label.mobile-field.content-type-field(for="snippet-type-button")
				span Content type
				input#snippet-type(type="hidden" value=snippetType)
				.type-picker#type-picker
					button#snippet-type-button(type="button" aria-haspopup="listbox" aria-expanded="false")
						span#snippet-type-label= {plain_text:'Text',code:'Code',rich_text:'Rich text'}[snippetType]
						span.material-symbols-outlined expand_more
					.type-menu#snippet-type-menu(role="listbox" hidden)
						each kind in ['plain_text','code','rich_text']
							button(type="button" role="option" data-snippet-type=kind aria-selected=kind===snippetType)= {plain_text:'Text',code:'Code',rich_text:'Rich text'}[kind]
			label.mobile-field#language-field(for="language" hidden=snippetType!=='code')
				span Code language
				select#language
					if !codeLanguages.some(item => item[0] === snippetLanguage)
						option(value=snippetLanguage selected)= snippetLanguage
					each language in codeLanguages
						option(value=language[0] selected=language[0]===snippetLanguage)= language[1]
		label.mobile-field.content-field(for="replace")
			textarea#replace(rows="10")= snippet && (snippet.content.markdown || snippet.content.text) || ''
		include ../../../server/views/ajax/rich-editor.pug
		include ../../../server/views/ajax/template-editor.pug
		p.draft-caption
			span.material-symbols-outlined cloud_done
			span Changes are saved locally while you edit.
