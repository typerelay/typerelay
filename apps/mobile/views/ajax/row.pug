article.snippet-row(data-record=snippet.id data-library=library._id)
	button.snippet-main(type="button" data-use=snippet.id aria-label='Open ' + (snippet.title || snippet.trigger || 'snippet'))
		span.snippet-kind(class='kind-' + snippet.content.type)
			span.material-symbols-outlined= snippet.content.type === 'rich_text' ? 'format_align_left' : snippet.content.type === 'template' ? 'variable_add' : snippet.content.type === 'code' ? 'code' : 'notes'
		span.snippet-copy
			strong= snippet.title || snippet.trigger || 'Untitled snippet'
			small
				span= library.name
				if snippet.trigger
					span.trigger-chip= snippet.trigger
			span.snippet-preview= snippet.content.text || snippet.content.markdown || 'Empty snippet'
	button.row-action(type="button" data-edit=snippet.id disabled=!library.permissions.edit aria-label='Edit ' + (snippet.title || snippet.trigger || 'snippet'))
		span.material-symbols-outlined edit
