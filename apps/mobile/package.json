{
  "name": "@typerelay/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/build-renderer.mjs && tsc --noEmit && vite build",
    "cap:sync": "pnpm assets && pnpm build && capacitor sync",
    "android:release": "bash scripts/android-release-bundle.sh",
    "native:ios": "node scripts/build-native.mjs ios",
    "native:android": "node scripts/build-native.mjs android",
    "test": "cargo test --manifest-path ../../Cargo.toml -p typerelay-mobile --lib",
    "assets": "node scripts/assets.mjs",
    "test:release": "node --test test/release-packaging.test.mjs",
    "test:ui": "node --test test/ui.test.mjs",
    "test:preview": "node --test test/preview-server.test.mjs"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.0",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/network": "^8.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/material-symbols-outlined": "^5.3.6",
    "bootstrap": "^5.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sweetalert2": "^11.26.25",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/bootstrap": "^5.2.11",
    "@types/pug": "^2.0.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "pug": "^3.0.4",
    "typescript": "^7.0.2"
  }
}
